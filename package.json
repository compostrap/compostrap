{
	"name": "compostrap",
	"version": "1.0.1",
	"description": "Bootstrap 5 for administrations and websites: a theme with the look and classes of Bootstrap 6, a layout with a sidebar, a multi-level menu and a navbar, and components Bootstrap does not have (datepicker, charts, gallery, lightbox, dropzone, sign-in pages, shop, blog).",
	"type": "module",
	"license": "MIT",
	"author": "Zdeněk Papučík",
	"homepage": "https://github.com/compostrap/compostrap",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/compostrap/compostrap.git"
	},
	"keywords": [
		"bootstrap",
		"bootstrap5",
		"theme",
		"admin",
		"dashboard",
		"sidebar",
		"menu",
		"dark-mode",
		"theme-switcher",
		"scss",
		"datepicker",
		"charts",
		"gallery",
		"lightbox",
		"dropzone",
		"datagrid",
		"e-commerce",
		"blog"
	],
	"files": [
		"dist",
		"src",
		"docs"
	],
	"sideEffects": [
		"*.css",
		"*.scss"
	],
	"exports": {
		".": "./dist/js/index.js",
		"./sidebar": "./dist/js/sidebar.js",
		"./sidebar-menu": "./dist/js/sidebar-menu.js",
		"./theme-switcher": "./dist/js/theme-switcher.js",
		"./tooltip": "./dist/js/tooltip.js",
		"./dropzone": "./dist/js/dropzone.js",
		"./lightbox": "./dist/js/lightbox.js",
		"./strength": "./dist/js/strength.js",
		"./password-toggle": "./dist/js/password-toggle.js",
		"./number-input": "./dist/js/number-input.js",
		"./otp-input": "./dist/js/otp-input.js",
		"./selection": "./dist/js/selection.js",
		"./datepicker": "./dist/js/datepicker.js",
		"./chart": "./dist/js/chart.js",
		"./spinner": "./dist/js/spinner.js",
		"./dialogs": "./dist/js/dialogs.js",
		"./css/*": "./dist/css/*",
		"./src/scss/*": "./src/scss/*",
		"./illustrations/*": "./src/illustrations/*"
	},
	"peerDependencies": {
		"bootstrap": "^5.3.0",
		"bootstrap-icons": "^1.11.0",
		"chart.js": "^4.6.0",
		"nanobar": "^0.4.2",
		"perfect-scrollbar": "^1.5.6",
		"vanilla-calendar-pro": "^3.4.0"
	},
	"peerDependenciesMeta": {
		"bootstrap-icons": {
			"optional": true
		},
		"nanobar": {
			"optional": true
		},
		"perfect-scrollbar": {
			"optional": true
		},
		"vanilla-calendar-pro": {
			"optional": true
		},
		"chart.js": {
			"optional": true
		}
	},
	"devDependencies": {
		"@playwright/test": "^1.65.0",
		"bootstrap": "^5.3.8",
		"bootstrap-icons": "^1.13.2",
		"chart.js": "^4.6.1",
		"nanobar": "^0.4.2",
		"perfect-scrollbar": "^1.5.6",
		"sass": "^1.97.1",
		"vanilla-calendar-pro": "^3.4.0",
		"vite": "^8.0.16"
	},
	"scripts": {
		"dev": "npm run demo && vite",
		"build": "vite build && node scripts/build-css.js",
		"demo": "node scripts/build-demo.js",
		"test": "playwright test",
		"prepublishOnly": "npm run build"
	}
}
